<script type="c6e6af3e561d8c57d28a9cd4-text/javascript">document.addEventListener("DOMContentLoaded", function () {

    const url = new URL(window.location.href);

    ['utm_source','utm_medium','utm_campaign'].forEach(function(key){
        const value = url.searchParams.get(key);

        if(value){
            localStorage.setItem(key,value);
        }

        const hidden = document.querySelector('input[name="'+key+'"]');

        if(hidden){
            hidden.value = localStorage.getItem(key) || '';
        }
    });

});</script><script id="jquery-core-js" src="https://secure-house.co.uk/wp-includes/js/jquery/jquery.min.js?ver=3.7.1" type="c6e6af3e561d8c57d28a9cd4-text/javascript"></script>
