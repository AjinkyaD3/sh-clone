# Copy this file to .env.local and fill in real values.

# Required for the /contact-us form and the "Get a Quote" panel to actually
# send email. Get a key from https://resend.com (free tier is enough to
# start). Until this is set, both forms validate input correctly but return
# a "not configured" error instead of sending - see app/api/enquiry/route.ts.
RESEND_API_KEY=

# Where enquiry emails are delivered. Defaults to info@secure-house.co.uk if unset.
CONTACT_TO_EMAIL=info@secure-house.co.uk

# The "From" address Resend sends as. Must be a verified domain/sender in
# your Resend account, or Resend will reject the send. onboarding@resend.dev
# works out of the box for testing before a domain is verified.
CONTACT_FROM_EMAIL=Secure House Website <onboarding@resend.dev>
